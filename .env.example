# Variables docker-compose.yml interpolates when it starts a container.
#
# This is NOT server/.env.example, which documents every setting the
# application itself reads (server/config.py). This file holds only the three
# knobs compose needs to know before the container exists.
#
# scripts/server_ctl.py writes and maintains ./.env for you -- it generates the
# token on first `up` and keeps it on every later one, so clients already
# configured against this server keep working. Copy this file by hand only if
# you are deploying without it.
#
# ./.env is gitignored. Keep it that way: it holds the deployment's API key.

# Bearer token every client must send. Generate a long random one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=change-me-to-a-long-random-secret

# "cuda" for the `inference` service on a GPU host, "cpu" otherwise. The
# `inference-cpu` service pins this to cpu itself and ignores the value here.
DEVICE=cuda

# Host address the port is published on. LEAVE IT UNSET (or empty) to publish
# on every interface, IPv4 and IPv6 -- that is the default and what a lab
# server behind a TLS terminator wants. Note that unset is NOT the same as
# "0.0.0.0": spelling it out restricts the publication to IPv4 and silently
# drops IPv6 clients.
#
# Exposing it at all is only acceptable behind a TLS terminator -- this server
# speaks plain HTTP and carries medical images. server_ctl.py writes
# 127.0.0.1 here for a local install, which is why that one is safe.
# BIND_ADDR=127.0.0.1

# Host port. The container always serves 8000 internally, so this only moves
# the host side -- change it when something else already holds 8000.
HOST_PORT=8000
