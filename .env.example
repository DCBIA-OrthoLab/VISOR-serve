# Variables docker-compose.yml interpolates when it starts a container.
#
# This is NOT server/.env.example, which documents every setting the
# application itself reads (server/config.py). This file holds only what
# compose needs to know BEFORE a container exists -- which port to publish,
# whether to ask for the card, where the tool folders are built from.
#
# scripts/server_ctl.py writes and maintains API_TOKEN, DEVICE, BIND_ADDR and
# HOST_PORT in ./.env for you -- it generates the token on first `up` and keeps
# it on every later one, so clients already configured against this server keep
# working. The two `venvs` variables at the bottom are hand-maintained: it does
# not manage that service. Copy this file by hand only if you deploy without it.
#
# ./.env is gitignored. Keep it that way: it holds the deployment's API key.

# Bearer token every client must send. Generate a long random one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=change-me-to-a-long-random-secret

# "cuda" for the `inference` service on a GPU host, "cpu" otherwise. The
# `inference-cpu` service pins this to cpu itself and ignores the value here.
DEVICE=cuda

# Host address the port is published on. LEAVE IT UNSET (or empty) to publish
# on every interface, IPv4 and IPv6 -- that is the default and what a lab
# server behind a TLS terminator wants. Note that unset is NOT the same as
# "0.0.0.0": spelling it out restricts the publication to IPv4 and silently
# drops IPv6 clients.
#
# Exposing it at all is only acceptable behind a TLS terminator -- this server
# speaks plain HTTP and carries medical images. server_ctl.py writes
# 127.0.0.1 here for a local install, which is why that one is safe.
# BIND_ADDR=127.0.0.1

# Host port. The container always serves 8000 internally, so this only moves
# the host side -- change it when something else already holds 8000.
HOST_PORT=8000

# --- the `venvs` service only -----------------------------------------------
# `inference` mounts ./server and runs the tools this repository imports;
# `inference-venvs` builds docker/Dockerfile, one virtualenv per packaged tool,
# and is the real deployment. Neither of the two below is managed by
# server_ctl.py.

# Build context the packaged tools come from: the root of a SADT-VISOR
# checkout, which is where its `tools/` and `scripts/` sit. NOT a `dist/`
# subdirectory. Unset, the build falls back to docker/fixtures -- three tools
# with incompatible pins that need no GPU and no model, and prove the layout.
TOOLS_CONTEXT=../SADT-VISOR

# Host port for `inference-venvs`. 8001 by default so it can run beside
# `inference` while tools are moved over; set it to HOST_PORT's value only once
# the other service is retired, since the two cannot both be up on one port.
VENVS_HOST_PORT=8001
