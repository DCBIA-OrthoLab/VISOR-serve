# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Virtual environments, the server's own and the per-tool ones
venv/
.venv/

# Secrets / local config
.env

# TLS dev certificates
*.pem

# Editor / OS
.vscode/
.idea/
.DS_Store

# Models
*.pth
*.pt
models/

# DATA
data/
DATA/

# Regenerated from each tool's source; source_hash is what keeps it honest.
.schema-cache/

# run-local.sh writes here.
local-server.log

# Scratch from manual validation runs (landmark comparisons, resolve probes).
.validation/

# Local dev servers: a second instance's schema cache and its log.
.schema-cache-*/
local-server-*.log

# The operator page's run history (server/.history, HISTORY_DIR)
.history/
# The learned cost table (server/.costs, COST_TABLE_PATH in docker-compose.yml)
.costs/
# The update agent and the server leave each other notes here (UPDATE_DIR)
.update/
# The update agent's log (scripts/server_ctl.py agent)
update_agent.log

# The certificate run-local.sh generates (server/tls.py)
server/.tls/
server/.local-token

# A public certificate an operator drops in (docker-compose.yml mounts it)
/tls/
