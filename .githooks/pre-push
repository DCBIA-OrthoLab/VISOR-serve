#!/usr/bin/env bash
# Runs the server test suite in Docker before allowing a push, so a broken
# tool or a regression never reaches the remote. Enabled per clone with:
#   git config core.hooksPath .githooks
#
# To push without running the tests (e.g. a documentation-only change, or
# Docker unavailable), use git's built-in bypass: `git push --no-verify`.
#
# This runs the `test` service, NOT `test-gpu`: the latter reserves an nvidia
# card (so it cannot start on a clone without one) and sets
# RUN_REAL_DATA_TESTS, which runs real inference against whatever bundles are
# in DATA/ -- eleven minutes on a GPU, hours on a CPU. Run it by hand when
# touching a tool's inference path:
#   docker compose run --rm test-gpu

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if docker compose version >/dev/null 2>&1; then
    compose=(docker compose)
elif command -v docker-compose >/dev/null 2>&1; then
    compose=(docker-compose)
else
    echo "pre-push: no docker compose (v2 plugin or standalone) found -- cannot run the test suite." >&2
    echo "Install Docker Compose, or bypass this check with: git push --no-verify" >&2
    exit 1
fi

echo "pre-push: running server test suite (${compose[*]} run --rm test)..."
"${compose[@]}" run --rm test
