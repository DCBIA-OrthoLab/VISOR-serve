# Copy this file to .env and fill in real values. Never commit the real .env.
#
# This is what the APPLICATION reads: every field of server/config.py, loaded
# by pydantic-settings relative to the server's working directory. The ./.env
# one directory up is a different file for a different reader -- docker
# compose interpolates that one into docker-compose.yml before a container
# exists. See ../.env.example.
#
# The deployment image sets most of what follows through ENV in
# docker/Dockerfile and needs no .env at all; this file is for a dev checkout
# running uvicorn directly. The groups below are config.py's own.

# --- core -----------------------------------------------------------------

# Bearer token the client must send as "Authorization: Bearer <API_TOKEN>".
API_TOKEN=change-me-to-a-long-random-secret

# "cuda" on the GPU server, "cpu" for local development. Injected into a tool's
# `device` argument when the caller picks none, so a tool that reads no
# environment of its own does not run on cuda on a CPU server.
DEVICE=cpu

# Directory for temporary input/output files. Created automatically if missing.
# Job directories are created here too, and removed with everything else once
# the response has been served. The deployment image uses /jobs.
TEMP_DIR=/tmp/inference_server

# Root directory for read-only server-side data (AI models, test files),
# organized as DATA_DIR/<tool_name>/{models,testfiles}/. See data_store.py.
DATA_DIR=/data

# Backend serving DATA_DIR. "local" is the only one implemented today; see
# data_store.py for how to add e.g. a database or object store backend.
DATA_BACKEND=local

# --- running a tool -------------------------------------------------------

# How a tool run is executed.
#
#   subprocess  the server writes a job.json and runs the tool through
#               runner.py in the tool's OWN virtualenv (see execution/).
#               Every packaged tool runs this way, and the deployment image
#               sets it. The server then imports no tool, is not pinned to the
#               lowest common Python across all of them, cannot be taken down
#               by a segfault in a CUDA kernel, and gives a tool's VRAM back
#               when its process exits.
#   inprocess   the server imports the tool and calls run() directly. All that
#               is left on this path are the two demos in tools/, which is why
#               it is still the default for a dev checkout.
#
# Either way the HTTP contract is identical and the request still blocks for
# the duration of the run.
SADT_DISPATCH_MODE=inprocess

# Root of the per-tool folders, each holding .schema.json, .venv/ and src/.
# Defaults to the tools/ folder inside the server tree; the deployment image
# puts them at /tools/, and run-local.sh points it at a SADT-VISOR checkout.
# TOOLS_DIR=/tools
#
# SEVERAL CATALOGUES: separate them the way PATH does. Serving a second
# library of tools is a path, not a code change.
# TOOLS_DIR=/tools:/srv/lab-tools
# They are scanned in the order written, and the server's own tools/ folder is
# always scanned last, so a packaged tool dropped beside the imported ones is
# found even when this names somewhere else. When two catalogues carry the same
# tool name the first one wins; the other is recorded against its folder path
# and printed in the startup banner, so the clash is visible rather than silent.

# runner.py, handed to the tool's interpreter by path rather than installed
# into each virtualenv -- so the runner and the server are always the same
# version. Defaults to the copy next to the server's own modules.
# RUNNER_PATH=/opt/sadt/server/execution/runner.py

# describe.py, which turns a tool's run() signature into its schema and has to
# run with THAT tool's interpreter. It ships with the tools, not with the
# server. Absent, only tools already carrying a .schema.json are served.
# DESCRIBE_PATH=/tools/scripts/describe.py

# Where a regenerated .schema.json is written. A schema is a CACHE of the
# source beside it, and the tool folders are read-only to the process serving
# them, so a regenerated one cannot live next to its tool.
# SCHEMA_CACHE_DIR=/var/cache/sadt

# Per-tool server-side configuration: which of a tool's arguments may be
# filled from DATA_DIR, and its upload limit. See deployment.toml.example.
# A missing file is the normal case, not an error. Defaults to the copy beside
# the server's own modules -- point it at a path that does not exist and every
# packaged tool falls back to its own lowercase name for the DATA lookup
# (`amasss` instead of `AMASSS`: no models, no test files, silently).
# DEPLOYMENT_CONFIG=/opt/sadt/server/deployment.toml

# Passed to a tool process as SADT_API, for a tool that needs to reach this
# server. API_TOKEN is deliberately NOT passed with it.
SADT_API=http://127.0.0.1:8000

# How many tool executions run at once. Requests beyond the cap wait for a free
# slot rather than piling unbounded work onto RAM/CPU/GPU.
MAX_CONCURRENT_TOOLS=4


# How many times a run that died for want of MEMORY is started again, with more
# room reserved each time. Every other failure is final: a bad argument fails
# identically however many times it is tried.
#
# Cheap here in a way it is not in an in-process design -- the tool is a
# subprocess, so the failure killed it and nothing else, and its inputs are
# still staged on disk, so a retry costs no transfer.
#
# 2 rather than more, because the escalation saturates: by the third attempt
# the run is asking for the whole budget, which means running alone, and a tool
# that runs out of memory ALONE does not fit at all. The server stops there on
# its own, earlier than this count, whenever that point is reached. 0 answers
# 500 on the first failure.
MEMORY_RETRIES=2
MEMORY_RETRY_GROWTH=1.5

# How many recent runs a tool's measured cost is taken from. An ALL-TIME
# maximum never comes back down, so one unusual scan would raise that tool's
# reservation for every run after it, for ever, and collapse its parallelism.
# The worst of the last N runs forgets an outlier once the tool has behaved
# normally N times.
#
# Safe only because MEMORY_RETRIES exists: forgetting a peak means occasionally
# admitting one job too many, which is now a retry rather than a failure.
COST_WINDOW=20

# The most channels any ONE tool may open inside a single run -- how many of
# its own scans, patients or meshes it may process at once. A tool that
# declares no `num_workers` or `batch_size` argument is unaffected: a
# capability nobody declared is not one the server may assume, because opening
# several channels inside a loop that shares a temporary file corrupts its own
# outputs silently.
#
# What the server actually grants is the smaller of this, the cores admission
# gave that run, and any per-tool `max_workers` in deployment.toml. The three
# compose downwards and nothing widens the cap.
#
# 8 rather than "as many cores as there are", because the resource a channel
# costs is not a core: a channel of AMASSS or Batch_Dental_Seg holds a
# decompressed volume. Twenty-one channels on a 42-core budget is gigabytes of
# host memory to save seconds -- and the cost table only learns that AFTER the
# run that took it, which is one out-of-memory too late.
#
# The grant is also a BUDGET that is divided on the way down a supervised
# chain. A nested call never re-enters admission (it is a subprocess of its
# parent), so without that division ASO opening six channels, each calling
# ALI_CBCT which opens eight, would be forty-eight channels on a machine that
# admitted one job.
SADT_MAX_CHANNELS=8

# The fewest cores a run may be ADMITTED holding, when the machine is busy
# enough that its full share does not fit.
#
# Cores are the one resource here that narrows safely: too few makes a run
# slow, where too little memory makes it die. So a run that would otherwise sit
# in the queue is admitted on fewer cores instead -- it starts, which is what
# the clinician in front of it is waiting for, and the cost of being narrowed
# is latency rather than failure.
#
# This is what makes the two axes independent. VRAM bounds the runs that touch
# the card; cores bound everything, and they FLEX -- so a CPU-bound cohort
# keeps starting runs long after the card stopped being the question. Measured
# here at ten clients of the heaviest tool: 19.3 GiB of VRAM in use out of 48,
# while the fixed per-job core share was what capped it at six jobs.
#
# 4: below that a tool stops being slow and starts being unusable, and a
# clinician staring at a bar that has not moved in ten minutes cannot tell it
# from a server that has died.
#
# Know what 1 costs before leaving it there. The grant is decided ONCE, at
# spawn -- a BLAS pool cannot be retuned from outside the process -- so a run
# admitted on one core keeps one core for its whole life even if the machine
# empties a second later. Admitting everything at one core trades a queue for
# universal slowness, which is how a scheduler thrashes: forty runs each eight
# times slower finish no sooner than six at a time, and all forty look broken
# while they do it. Measured here, six concurrent AMASSS already stretch from
# 79s to ~145s at seven cores each.
#
# Raise it to 2 or 4 on a deployment that would rather queue than crawl.
SADT_MIN_CPUS_PER_JOB=4

# --- what this machine gives the server -------------------------------------
#
# LEAVE ALL OF THIS UNSET on a normal deployment. The server sizes itself to
# the machine it starts on and prints what it decided; these exist for the
# deployment that wants to say otherwise. The startup banner names which of
# them took effect.
#
# Detection reads the CONTAINER's limit before the machine's, so
#     deploy: {resources: {limits: {cpus: '16', memory: 64G}}}
# in the compose file is already a complete answer and needs nothing here. A
# Kubernetes pod's resources.limits sets the same cgroup files and works the
# same way.
#
# Each of the six budget variables accepts a percentage of what was detected, a
# bare number, or a size: "75%", "8", "16GB".

# What the server takes of the machine when nothing below says otherwise. Under
# 1 on purpose: the host runs other things, and on a workstation that includes
# the Slicer the clinician is using.
# SADT_RESOURCE_SHARE=0.75

# How many people are expected to use this server at once. A DECLARATION, not a
# detection: there is one shared API token and no client identity, so the
# server cannot tell ten workstations from one clicking ten times.
#
# It buys the per-job caps: with 10, a run is given a tenth of the budget and
# no single cohort can take the machine. With 1 -- a single workstation --
# there is no cap and every run goes as wide as the hardware allows, which is
# what a single user wants. The split never goes finer than the budget's own
# core count, so a large number stops dividing rather than inventing shares no
# tool could use.
# SADT_EXPECTED_CLIENTS=4

# The budgets themselves, if detection is not what you want.
# SADT_CPU_BUDGET=
# SADT_RAM_BUDGET=
# SADT_VRAM_BUDGET=

# A per-job cap, overriding the one derived from SADT_EXPECTED_CLIENTS. A cap
# is a fairness target, not a refusal: a job whose measured cost exceeds its cap
# still runs, alone.
# SADT_CPU_PER_JOB=
# SADT_RAM_PER_JOB=
# SADT_VRAM_PER_JOB=

# Seconds a tool process may run before it is killed. 0 means no limit, which
# is what the in-process path does -- a whole-cohort segmentation legitimately
# runs for hours. It bounds a whole supervised chain, not one hop of it.
TOOL_TIMEOUT_SECONDS=0

# --- splitting a cohort ---------------------------------------------------

# A folder of inputs is sent as several runs rather than one archive, and these
# say how much goes in one of them. Whichever binds first wins; 0 on both turns
# batching off and a cohort travels whole again, as it did before this existed.
#
# Megabytes first, on purpose: what a batch protects is this machine's
# bandwidth, disk and upload limit, none of which is a property of a tool. It
# also sizes itself to the data -- 20 intraoral surfaces of 5 MB go together,
# 8 CBCTs of 50 MB do not -- which no file count can do. Keep it under
# MAX_UPLOAD_MB, or every batch answers 413.
BATCH_MAX_MB=400

# The ceiling bytes cannot supply: 5 000 clinical notes of 20 KB are 100 MB,
# one batch, and no partial result until the last one is done.
BATCH_MAX_FILES=25

# --- uploads and results --------------------------------------------------

# Reject uploads larger than this (megabytes) with 413.
MAX_UPLOAD_MB=500

# Cap on the UNCOMPRESSED size of an archive the server extracts for a
# "folder"-typed argument. Guards against a small zip expanding to hundreds of
# GB and filling TEMP_DIR. Archives over this are rejected with 400.
MAX_EXTRACTED_MB=2000

# Default part size for a chunked upload, in MB. A client may ask for another;
# the server clamps the request to [1, 64] and answers with what it used, and
# both sides compute every part offset from that one number.
UPLOAD_CHUNK_MB=8

# IDLE timeout for an upload session or a held result, not an age limit: every
# part written and every range read stamps its directory, so a transfer still
# in flight never expires however long it takes, while one whose client
# vanished expires this many seconds later.
TRANSFER_TTL_SECONDS=900

# How often the reaper sweeps for expired transfers. On a timer rather than
# only when a new session is created: an abandoned transfer sits longest
# exactly when no new request arrives to trigger an opportunistic sweep. Worst
# case for patient data left on disk by a client that died mid-download is
# TRANSFER_TTL_SECONDS + this.
TRANSFER_SWEEP_SECONDS=60

# Below this, a result is streamed in the /run response whatever the client
# asked for. A stream deletes its file when the response ends, even on a
# client that disconnects mid-body, while a reference waits for a DELETE or
# for the reaper -- and parallel ranges buy nothing under 16 MB, so the
# stronger cleanup guarantee is kept for the overwhelming majority of runs.
RESULT_REFERENCE_MIN_MB=16

# DEFLATE level for result archives. 1 by default: level 6 was measured twice
# as slow for ~3% of size on the only members still worth compressing --
# already-compressed files (.nii.gz, .zip, .xlsx, ...) are stored as-is
# whatever this says, since DEFLATE gains ~0% on them.
ZIP_COMPRESSLEVEL=1

# Fallback for generic "file"-typed arguments only. Tools with a specific
# file type (zip_file, csv_file, ...) are validated against that type's own
# extensions instead, regardless of this list. "*" accepts everything.
ALLOWED_EXTENSIONS=[".nii", ".nii.gz"]

# --- run progress and cancellation ----------------------------------------
#
# A client that sends X-Run-Id on a run can watch its progress and cancel it;
# one that does not gets exactly the behaviour it always had, and none of these
# settings apply to it. See ../RUN_PROGRESS.md for the whole contract.

# IDLE timeout for a run directory, the same shape as TRANSFER_TTL_SECONDS:
# every event appended and every event read stamps it, so a cohort reporting
# progress for hours never expires under itself. The normal path removes a run
# with its request, so this only bounds the one whose client vanished mid-POST
# -- and it needs bounding because a progress message is written by a tool and
# can name a file. Swept by the same reaper, on TRANSFER_SWEEP_SECONDS.
RUN_TTL_SECONDS=900
# Idle TTL of a run STOPPED at a quality-control checkpoint, which waits on a
# person rather than on a machine. 4 hours.
PAUSED_RUN_TTL_SECONDS=14400

# How often GET /runs/{id}/events tails the event file. This is the latency a
# clinician sees on a progress bar, and each poll reads only the bytes appended
# since the last one.
RUN_EVENT_POLL_SECONDS=0.25

# How often a run in flight checks whether its client has cancelled it: one
# stat per interval per running tool. It bounds how long a cancelled run with
# no process yet -- staging its inputs, or queued for the card -- keeps going.
# A run that HAS a process is signalled immediately and does not wait for this.
RUN_CANCEL_POLL_SECONDS=1.0

# Events reported per run. A tool reporting per slice in a 500-patient cohort
# must not fill TEMP_DIR; past the cap one "not reported" event is delivered
# and the rest are dropped, terminal events always excepted so a watcher's
# stream can still end.
MAX_RUN_EVENTS=2000
