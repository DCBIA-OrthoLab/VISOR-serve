# Copy this file to .env and fill in real values. Never commit the real .env.

# Bearer token the client must send as "Authorization: Bearer <API_TOKEN>".
API_TOKEN=change-me-to-a-long-random-secret

# "cuda" on the GPU server, "cpu" for local development. Individual tools
# read this to decide where to run.
DEVICE=cpu

# Reject uploads larger than this (megabytes) with 413.
MAX_UPLOAD_MB=500

# Cap on the UNCOMPRESSED size of an archive the server extracts for a
# "folder"-typed argument. Guards against a small zip expanding to hundreds of
# GB and filling TEMP_DIR. Archives over this are rejected with 400.
MAX_EXTRACTED_MB=2000

# Directory for temporary input/output files. Created automatically if missing.
# Job directories (see SADT_DISPATCH_MODE) are created here too, and removed
# with everything else once the response has been served.
TEMP_DIR=/tmp/inference_server

# How a tool run is executed.
#
#   inprocess   the server imports the tool and calls run() directly. What it
#               has always done, and still the default.
#   subprocess  the server writes a job.json and runs the tool through
#               runner.py in the tool's OWN virtualenv (see dispatch.py).
#
# The second is where this is going: the server then never imports torch, is
# not pinned to the lowest common Python across every tool, cannot be taken
# down by a segfault in a CUDA kernel, and gives a tool's VRAM back when its
# process exits. Either way the HTTP contract is identical and the request
# still blocks for the duration of the run.
#
# TEMPORARY, and removed once every tool has moved over.
SADT_DISPATCH_MODE=inprocess

# Root of the per-tool folders, each holding .venv/ and src/. Defaults to the
# tools/ folder inside the server tree; the deployment image puts them at
# /tools/<name>/ instead.
# TOOLS_DIR=/tools

# runner.py, handed to the tool's interpreter by path rather than installed
# into each virtualenv -- so the runner and the server are always the same
# version. Defaults to the copy next to the server's own modules.
# RUNNER_PATH=/opt/sadt/runner.py

# Passed to a tool process as SADT_API, for a tool that needs to reach this
# server. API_TOKEN is deliberately NOT passed with it.
SADT_API=http://127.0.0.1:8000

# Seconds a tool process may run before it is killed. 0 means no limit, which
# is what the in-process path does -- a whole-cohort segmentation legitimately
# runs for hours.
TOOL_TIMEOUT_SECONDS=0

# How many tool executions run at once. Requests beyond the cap wait for a free
# slot rather than piling unbounded work onto RAM/CPU/GPU.
MAX_CONCURRENT_TOOLS=4

# How many AMASSS inferences may touch the GPU at once. AMASSS predicts its
# structures sequentially, so this only arbitrates between concurrent requests
# and is pointless above MAX_CONCURRENT_TOOLS. Raising it also means raising
# docker-compose's shm_size: nnUNet's workers pass whole volumes through shared
# memory, and running out of it shows up as a SIGBUS in a worker, not as a clean
# out-of-memory error. Applied at startup; a change needs a restart.
AMASSS_MAX_GPU_JOBS=1

# The same cap for ALI, counted separately and much higher: a CBCT run was
# measured peaking at 256 MiB of VRAM (one small DenseNet over a 64^3 crop), so
# memory is never the constraint and a limit of 1 only made two concurrent
# requests wait ~6.5s per landmark for each other. Matching
# MAX_CONCURRENT_TOOLS means "no extra limit" in practice.
ALI_MAX_GPU_JOBS=4

# Seconds one CBCT landmark agent may search before it is reported as not
# found. Leave unset to derive it from DEVICE: 15s on a GPU, 60s on CPU, where
# each search step is a forward pass and convergence takes several times
# longer. Budget is per landmark, per scan.
# ALI_SEARCH_MAX_SECONDS=15

# How many CrownSeg segmentations may touch the GPU at once.
CROWNSEG_MAX_GPU_JOBS=1

# Mesh-loading worker processes for CrownSeg. Must be >= 1: shapeaxi builds its
# DataLoader with persistent_workers=True, which PyTorch rejects at 0.
CROWNSEG_NUM_WORKERS=2

# Crown-segmentation checkpoint in DATA_DIR/CrownSeg/models/, used when no
# model is named -- including by ALI's IOS mode when it is handed a mesh with
# no tooth labels. Staged server-side on purpose: the alternative is shapeaxi
# downloading it from GitHub mid-request, and this server does not make
# outbound calls while holding patient data.
CROWNSEG_MODEL=07-21-22_val-loss0.169.pth

# Run AMASSS's resampling on the GPU instead of on one CPU core. This is what
# dominates a run: on a 512x512x365 CBCT, one structure spends 14.6s
# resampling the input and 6.9s resampling the logits back, around 4.5s of
# actual inference. Selecting nnUNet's own torch resamplers takes those to
# 0.14s and 0.40s -- the default five-structure run goes from 195.9s to 77.0s.
# It does move the masks slightly (torch has no 3D cubic interpolation, so the
# input resampling drops to linear): Dice against the scipy pipeline measured
# MAND 0.998, UAW 0.997, MAX 0.995, CB 0.991, CV 0.978. Set to false for
# bit-identical nnUNet output. No effect when DEVICE=cpu.
AMASSS_GPU_RESAMPLING=true

# Sliding-window overlap (nnUNet's tile_step_size). Lower means more overlapping
# windows: 0.5 covers a voxel about eight times, 0.7 about three. Only the GPU
# share of a run scales with it, so it buys much less than AMASSS_GPU_RESAMPLING
# -- and unlike it, this changes the segmentation (0.7 measures Dice 0.995
# against 0.5). Raise it only after looking at the masks.
AMASSS_TILE_STEP_SIZE=0.5

# How many landmark triplets ASO's coarse alignment evaluates. Every ordered
# triplet is tried when there are at most this many (7 landmarks is 210), so
# raising it only matters for a selection above ~14 landmarks -- and buys very
# little, since the ICP that follows refines the result anyway.
ASO_ICP_MAX_TRIPLETS=2500

# Seed for that search when it has to sample instead of enumerating. Fixed so
# the same request always produces the same orientation.
ASO_ICP_SEED=0

# The tool ASO asks for CBCT landmarks in Fully-Automated mode. Deployed here,
# so that mode is live; a server without it answers 422 with a message saying so.
ASO_LANDMARK_TOOL=ALI

# DEFLATE level for result archives. 1 by default: level 6 was measured twice
# as slow for ~3% of size on the only members still worth compressing --
# already-compressed files (.nii.gz, .zip, .xlsx, ...) are stored as-is
# whatever this says, since DEFLATE gains ~0% on them.
ZIP_COMPRESSLEVEL=1

# Fallback for generic "file"-typed arguments only. Tools with a specific
# file type (zip_file, csv_file, ...) are validated against that type's own
# extensions instead, regardless of this list.
ALLOWED_EXTENSIONS=[".nii", ".nii.gz"]

# Root directory for read-only server-side data (AI models, test files),
# organized as DATA_DIR/<tool_name>/{models,testfiles}/. See data_store.py.
DATA_DIR=/data

# Backend serving DATA_DIR. "local" is the only one implemented today; see
# data_store.py for how to add e.g. a database or object store backend.
DATA_BACKEND=local
