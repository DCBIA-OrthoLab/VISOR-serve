# Copy this file to .env and fill in real values. Never commit the real .env.

# Bearer token the client must send as "Authorization: Bearer <API_TOKEN>".
API_TOKEN=change-me-to-a-long-random-secret

# "cuda" on the GPU server, "cpu" for local development. Individual tools
# read this to decide where to run.
DEVICE=cpu

# Reject uploads larger than this (megabytes) with 413.
MAX_UPLOAD_MB=500

# Cap on the UNCOMPRESSED size of an archive the server extracts for a
# "folder"-typed argument. Guards against a small zip expanding to hundreds of
# GB and filling TEMP_DIR. Archives over this are rejected with 400.
MAX_EXTRACTED_MB=2000

# Directory for temporary input/output files. Created automatically if missing.
# Job directories (see SADT_DISPATCH_MODE) are created here too, and removed
# with everything else once the response has been served.
TEMP_DIR=/tmp/inference_server

# How a tool run is executed.
#
#   inprocess   the server imports the tool and calls run() directly. What it
#               has always done, and still the default.
#   subprocess  the server writes a job.json and runs the tool through
#               runner.py in the tool's OWN virtualenv (see dispatch.py).
#
# The second is where this is going: the server then never imports torch, is
# not pinned to the lowest common Python across every tool, cannot be taken
# down by a segfault in a CUDA kernel, and gives a tool's VRAM back when its
# process exits. Either way the HTTP contract is identical and the request
# still blocks for the duration of the run.
#
# TEMPORARY, and removed once every tool has moved over.
SADT_DISPATCH_MODE=inprocess

# Root of the per-tool folders, each holding .venv/ and src/. Defaults to the
# tools/ folder inside the server tree; the deployment image puts them at
# /tools/<name>/ instead.
# TOOLS_DIR=/tools

# runner.py, handed to the tool's interpreter by path rather than installed
# into each virtualenv -- so the runner and the server are always the same
# version. Defaults to the copy next to the server's own modules.
# RUNNER_PATH=/opt/sadt/runner.py

# Passed to a tool process as SADT_API, for a tool that needs to reach this
# server. API_TOKEN is deliberately NOT passed with it.
SADT_API=http://127.0.0.1:8000

# Seconds a tool process may run before it is killed. 0 means no limit, which
# is what the in-process path does -- a whole-cohort segmentation legitimately
# runs for hours.
TOOL_TIMEOUT_SECONDS=0

# Per-tool server-side configuration: which of a tool's arguments may be
# filled from DATA_DIR, and its upload limit. See deployment.toml.example.
# A missing file is the normal case, not an error.
# DEPLOYMENT_CONFIG=/opt/sadt/deployment.toml

# How many tool executions run at once. Requests beyond the cap wait for a free
# slot rather than piling unbounded work onto RAM/CPU/GPU.
MAX_CONCURRENT_TOOLS=4












# DEFLATE level for result archives. 1 by default: level 6 was measured twice
# as slow for ~3% of size on the only members still worth compressing --
# already-compressed files (.nii.gz, .zip, .xlsx, ...) are stored as-is
# whatever this says, since DEFLATE gains ~0% on them.
ZIP_COMPRESSLEVEL=1

# Fallback for generic "file"-typed arguments only. Tools with a specific
# file type (zip_file, csv_file, ...) are validated against that type's own
# extensions instead, regardless of this list.
ALLOWED_EXTENSIONS=[".nii", ".nii.gz"]

# Root directory for read-only server-side data (AI models, test files),
# organized as DATA_DIR/<tool_name>/{models,testfiles}/. See data_store.py.
DATA_DIR=/data

# Backend serving DATA_DIR. "local" is the only one implemented today; see
# data_store.py for how to add e.g. a database or object store backend.
DATA_BACKEND=local
