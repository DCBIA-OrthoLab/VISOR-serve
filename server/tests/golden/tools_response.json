  {
    "name": "AMASSS",
    "arguments": {
      "input": {
        "type": "volume_or_zip_file",
        "types": [
          "volume_or_zip_file",
          "folder"
        ],
        "required": true,
        "description": "A CBCT scan (.nii/.nii.gz/.nrrd/.nrrd.gz/.gipl/.gipl.gz), or a folder of scans for batch segmentation (sent as a .zip archive)",
        "server_selectable": "testfile",
        "choices": null,
        "initial": null,
        "extensions": {
          "volume_or_zip_file": [
            ".nii",
            ".nii.gz",
            ".nrrd",
            ".nrrd.gz",
            ".gipl",
            ".gipl.gz",
            ".zip"
          ],
          "folder": [
            ".zip"
          ]
        },
        "label": null,
        "section": null,
        "visible_when": null,
        "ui": null,
        "groups": null
      },
      "model": {
        "type": "str",
        "types": [
          "str"
        ],
        "required": true,
        "description": "Name of a model bundle hosted on the server (see GET /tools/AMASSS/data): one subfolder per structure code (MAND/, MAX/, ...), each holding an nnUNet v2 model",
        "server_selectable": "model",
        "choices": null,
        "initial": null,
        "extensions": null,
        "label": null,
        "section": null,
        "visible_when": null,
        "ui": null,
        "groups": null
      },
      "structures": {
        "type": "multichoice",
        "types": [
          "multichoice"
        ],
        "required": true,
        "description": "Anatomical structures to segment",
        "server_selectable": null,
        "choices": {
          "Mandible": true,
          "Maxilla": true,
          "Cranial base": true,
          "Cervical vertebra": true,
          "Upper airway": true,
          "Skin": false,
          "Cranial base (Mask)": false,
          "Mandible (Mask)": false,
          "Maxilla (Mask)": false
        },
        "initial": null,
        "extensions": null,
        "label": null,
        "section": null,
        "visible_when": null,
        "ui": null,
        "groups": null
      },
      "merge": {
        "type": "multichoice",
        "types": [
          "multichoice"
        ],
        "required": false,
        "description": "Merged: one multi-label file per scan. Separated: one binary file per structure. Both may be selected",
        "server_selectable": null,
        "choices": {
          "One merged segmentation file": true,
          "Separated segmentation files": false
        },
        "initial": null,
        "extensions": null,
        "label": null,
        "section": null,
        "visible_when": null,
        "ui": null,
        "groups": null
      },
      "prediction_ID": {
        "type": "str",
        "types": [
          "str"
        ],
        "required": false,
        "description": "Suffix used in output file names, e.g. scan_Pred_MAND.nii.gz",
        "server_selectable": null,
        "choices": null,
        "initial": "Pred",
        "extensions": null,
        "label": null,
        "section": null,
        "visible_when": null,
        "ui": null,
        "groups": null
      },
      "generate_surface": {
        "type": "bool",
        "types": [
          "bool"
        ],
        "required": false,
        "description": "Also export a 3D surface (.vtk) alongside each segmentation",
        "server_selectable": null,
        "choices": null,
        "initial": false,
        "extensions": null,
        "label": null,
        "section": null,
        "visible_when": null,
        "ui": null,
        "groups": null
      },
      "surface_smoothing": {
        "type": "int",
        "types": [
          "int"
        ],
        "required": false,
        "description": "Smoothing iterations for the surfaces (0-95), ignored without generate_surface",
        "server_selectable": null,
        "choices": null,
        "initial": 5,
        "extensions": null,
        "label": null,
        "section": null,
        "visible_when": null,
        "ui": null,
        "groups": null
      },
      "surface_decimation": {
        "type": "int",
        "types": [
          "int"
        ],
        "required": false,
        "description": "Percentage of surface triangles to drop (0-99). 90 keeps the shape to well under a voxel while making the .vtk usable; 0 keeps every triangle. Ignored without generate_surface",
        "server_selectable": null,
        "choices": null,
        "initial": 90,
        "extensions": null,
        "label": null,
        "section": null,
        "visible_when": null,
        "ui": null,
        "groups": null
      }
    },
    "output_kind": "files"
  },
  {
    "name": "ASO",
    "arguments": {
      "modality": {
        "type": "choice",
        "types": [
          "choice"
        ],
        "required": true,
        "description": "CBCT: cone-beam CT volumes. IOS: intra-oral surface scans",
        "server_selectable": null,
        "choices": {
          "CBCT": true,
          "IOS": false
        },
