      "automation": {
        "type": "choice",
        "types": [
          "choice"
        ],
        "required": true,
        "description": "Semi-Automated: you send the landmarks (.mrk.json) alongside each scan. Fully-Automated: CBCT landmarks are predicted server-side, IOS meshes are oriented from their tooth labels",
        "server_selectable": null,
        "choices": {
          "Semi-Automated": true,
          "Fully-Automated": false
        },
        "initial": null,
        "extensions": null,
